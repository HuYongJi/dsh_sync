SYNC_DATA_DIR=/var/lib/dsh-sync
SYNC_HOST=127.0.0.1
SYNC_PORT=8787
SYNC_USERNAME=owner
# Bootstrap only. After an authenticated password change, this obsolete file is not read.
SYNC_PASSWORD_FILE=/etc/dsh-sync/password
# Access token lifetime: 24 hours. Legacy logins require re-login after expiry.
# Explicit remembered v2 device grants rotate with a 30-day idle / 90-day absolute
# refresh limit. Password changes revoke every access and refresh credential.
SYNC_TOKEN_TTL_MS=86400000

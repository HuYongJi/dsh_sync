SYNC_DATA_DIR=/var/lib/dsh-sync
SYNC_HOST=127.0.0.1
SYNC_PORT=8787
SYNC_USERNAME=owner
# Bootstrap only. After an authenticated password change, this obsolete file is not read.
SYNC_PASSWORD_FILE=/etc/dsh-sync/password
# 24 hours. Re-login after expiry or password changes; no permanent refresh token.
SYNC_TOKEN_TTL_MS=86400000

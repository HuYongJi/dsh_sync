{
  "name": "dsh-personal-sync",
  "version": "0.3.2",
  "description": "Local-first checkpoint sync and personal authentication for DeepSeek Harness",
  "type": "module",
  "main": "./plugin/index.mjs",
  "exports": { ".": "./plugin/index.mjs", "./client": "./client/dist/client.js", "./package.json": "./package.json" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-connection"]
    }
  },
  "bin": { "dsh-sync": "./src/cli.mjs", "dsh-sync-server": "./server/main.mjs" },
  "engines": { "node": ">=24.0.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-catalog": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2"
  },
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "start": "node server/main.mjs",
    "build:client": "node scripts/build-client.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "files": ["src", "plugin", "client", "server", "deploy", "cordis.patch.yml", "README.md", "docs", "LICENSE"],
  "license": "MIT"
}
